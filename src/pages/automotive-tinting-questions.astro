          "@type": "Question",
          "name": "How dark can I legally tint in Victoria?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Victoria sets a minimum VLT (visible light transmission) for front side windows, with rear windows allowed darker. We fit compliant film and advise on the darkest legal option."
          }
        },
        {
          "@type": "Question",
          "name": "What tint is best for heat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ceramic film offers the best heat rejection and clarity without needing to go dark. Carbon film is a great durable mid-tier option."
          }
        },
        {
          "@type": "Question",
          "name": "Will tint fade or go purple?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Quality carbon and ceramic films won't — they hold their colour for years. Cheap dyed film is what fades and turns purple."
          }
        },
        {
          "@type": "Question",
          "name": "Does tint block UV?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — quality film blocks the large majority of UV, protecting your interior from fading and you from sun exposure."
          }
        },
        {
          "@type": "Question",
          "name": "How much does tinting cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the car and the film tier. Ceramic costs more than carbon but rejects more heat. We'll quote your specific vehicle."
          }
        },
        {
          "@type": "Question",
          "name": "How long does tinting take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A typical car is done in a few hours. We fit in a clean, controlled environment for a flawless, bubble-free finish."
          }
        }
      ]
    }
