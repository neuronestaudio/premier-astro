---
import Base from '../layouts/Base.astro';
const page = {
  title: 'Page Not Found | Premier Mobile Detailing',
  description: 'That page does not exist. Head back to Premier Mobile Detailing.',
  canonical: 'https://premiermobiledetailing.com.au/404',
  robots: 'noindex',
  root: true, wrapper: null, header: 'page', footer: 'compact',
};
---
<Base {...page}>
  <section class="relative overflow-hidden" style="min-height:70vh;display:flex;align-items:center">
    <div class="container relative z-10 text-center" style="padding-top:120px;padding-bottom:80px">
      <p class="text-primary font-semibold tracking-wider uppercase text-sm mb-3">404</p>
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 text-white">That page has moved on.</h1>
      <p class="text-xl text-muted-foreground mb-10 max-w-2xl mx-auto">The link you followed doesn't exist any more. The detailing does.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/" class="inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground hover:bg-primary/90 rounded-md h-14 px-12 font-semibold shadow-lg transition-all">Back to Home</a>
        <a href="/booking" class="inline-flex items-center justify-center gap-2 border bg-background border-white/20 text-white hover:bg-white/10 rounded-md h-14 px-8 font-semibold transition-all">Book Now</a>
      </div>
    </div>
  </section>
</Base>
