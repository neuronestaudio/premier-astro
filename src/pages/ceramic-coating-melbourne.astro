---
import Base from '../layouts/Base.astro';
import html from '../content-html/ceramic-coating-melbourne.html?raw';
const page = {
  "title": "Ceramic Coating Melbourne | GYEON & ONYX | Premier Mobile Detailing",
  "description": "Professional GYEON & ONYX ceramic coating in Melbourne, applied at your door across the South-East. Deep gloss, UV and salt-air protection, manufacturer-backed warranties.",
  "canonical": "https://premiermobiledetailing.com.au/ceramic-coating-melbourne",
  "robots": null,
  "og": {
    "title": "Ceramic Coating Melbourne | GYEON & ONYX | Premier Mobile Detailing",
    "description": "Professional GYEON & ONYX ceramic coating in Melbourne, applied at your door across the South-East. Deep gloss, UV and salt-air protection, manufacturer-backed warranties.",
    "type": "website",
    "url": "https://premiermobiledetailing.com.au/ceramic-coating-melbourne"
  },
  "twitter": {},
  "jsonld": [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Ceramic Coating",
      "areaServed": "South-East Melbourne, VIC",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Premier Mobile Detailing",
        "telephone": "0411566186",
        "areaServed": "South-East Melbourne",
        "url": "https://premiermobiledetailing.com.au/"
      },
      "url": "https://premiermobiledetailing.com.au/ceramic-coating-melbourne"
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is ceramic coating worth it in Melbourne?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — arguably more than most places. Australia's UV is brutal, and Melbourne adds coastal salt, hard water and unpredictable weather. A coating keeps your paint sharper for years and makes maintenance easy."
          }
        },
        {
          "@type": "Question",
          "name": "Do you come to me?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We're fully mobile across Officer, Berwick, Pakenham, Cranbourne, Clyde, Narre Warren, Frankston, Dandenong and the wider South-East Melbourne region. Ceramic coatings need to cure under cover, so we work in your garage or carport with access to a tap and power."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A paint enhancement and ceramic coating is typically a full day. Multi-stage paint correction before a coating can take two days. Spray ceramics are faster."
          }
        },
        {
          "@type": "Question",
          "name": "Which coating should I choose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on your car, budget and how long you're keeping it. Tell us and we'll recommend the right GYEON or ONYX product — from 12 months up to a lifetime warranty."
          }
        }
      ]
    }
  ],
  "preloads": [],
  "styles": [
    "body{background:#080B16;margin:0;color:#fff}\n.pmdc{position:relative;isolation:isolate;overflow:hidden;padding-block:clamp(3.5rem,8vw,6rem);border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);background:#0a0f1c}\n.pmdc-media{position:absolute;inset:0;z-index:-1}\n.pmdc-vid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .9s cubic-bezier(.4,0,.2,1)}\n.pmdc-vid[data-on='true']{opacity:.45}\n.pmdc-scrim{position:absolute;inset:0;background:linear-gradient(100deg,rgba(8,11,22,.96) 6%,rgba(8,11,22,.88) 38%,rgba(8,11,22,.55) 80%,rgba(8,11,22,.72)),radial-gradient(90% 70% at 18% 50%,rgba(37,99,235,.15),transparent 62%)}\n.pmdc-word{position:absolute;right:2vw;bottom:-.12em;font-family:'Bebas Neue',Impact,sans-serif;font-size:clamp(4rem,13vw,12rem);line-height:.82;color:transparent;-webkit-text-stroke:1.5px rgba(255,255,255,.10);pointer-events:none;user-select:none;white-space:nowrap}\n.pmdc-inner{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(1.5rem,3vw,2.4rem)}\n.pmdc-head{max-width:46rem}\n.pmdc-eyebrow{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.18em;color:#60a5fa;margin:0 0 .6rem}\n.pmdc-display{font-family:'Bebas Neue',Impact,sans-serif;font-size:clamp(34px,6vw,64px);line-height:1;color:#fff;margin:0;letter-spacing:.01em}\n.pmdc-hl{color:#3b82f6}\n.pmdc-lede{margin-top:.5rem;color:#c3cad7;font-size:clamp(15px,1.9vw,17px);line-height:1.7;max-width:46rem}\n.pmdc-panel{position:relative;isolation:isolate;display:grid;gap:1.1rem;max-width:44rem;border-radius:24px;padding:clamp(1.6rem,3.2vw,2.4rem);border:1px solid rgba(59,130,246,.35);background:linear-gradient(148deg,rgba(20,28,47,.9),rgba(15,21,36,.72) 42%,rgba(15,21,36,.62) 72%),rgba(15,21,36,.5);-webkit-backdrop-filter:blur(22px) saturate(140%);backdrop-filter:blur(22px) saturate(140%);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 30px 70px -34px rgba(0,0,0,.8)}\n.pmdc-panel::before{content:'';position:absolute;inset:0;z-index:-1;border-radius:inherit;background:radial-gradient(70% 90% at 0% 0%,rgba(37,99,235,.18),transparent 62%);pointer-events:none}\n.pmdc-panel:focus-visible{outline:2px solid #3b82f6;outline-offset:4px}\n.pmdc-card{display:grid;grid-template-columns:auto 1fr;gap:1.1rem;align-items:start;animation:pmdcIn .42s cubic-bezier(.22,1,.36,1) both}\n@keyframes pmdcIn{from{opacity:0;transform:translate3d(18px,0,0)}to{opacity:1;transform:none}}\n.pmdc-n{font-family:'Bebas Neue',Impact,sans-serif;font-size:3.2rem;line-height:.9;color:#3b82f6}\n.pmdc-txt h3{margin:0 0 .6rem;color:#fff;font-family:'Bebas Neue',Impact,sans-serif;font-size:clamp(1.4rem,2.8vw,2rem);line-height:1.15;letter-spacing:.01em}\n.pmdc-txt p{margin:0;color:#c3cad7;line-height:1.7;font-size:.97rem}\n.pmdc-controls{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap;min-width:0}\n.pmdc-arrow{width:44px;height:44px;flex:none;border-radius:999px;cursor:pointer;display:grid;place-items:center;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);color:#fff;transition:background .22s,border-color .22s}\n.pmdc-arrow:hover{background:rgba(59,130,246,.22);border-color:rgba(59,130,246,.7)}\n.pmdc-arrow svg{width:18px;height:18px}\n.pmdc-pips{display:flex;gap:.4rem;flex-wrap:wrap;flex:1;min-width:0}\n.pmdc-pip{cursor:pointer;padding:.5rem .85rem;border-radius:999px;font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#c3cad7;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.14);transition:color .22s,background .22s,border-color .22s}\n.pmdc-pip:hover{color:#fff;border-color:rgba(59,130,246,.65)}\n.pmdc-pip[aria-selected='true']{color:#fff;background:linear-gradient(135deg,#3b82f6,#2563eb);border-color:transparent;box-shadow:0 6px 18px -8px rgba(37,99,235,.9)}\n.pmdc-count{margin:0;font-size:.78rem;color:#8b95a7;letter-spacing:.04em}\n@media (max-width:860px){.pmdc-word{font-size:clamp(3rem,18vw,6rem);right:auto;left:50%;translate:-50% 0}.pmdc-card{grid-template-columns:1fr;gap:.5rem}.pmdc-pips{order:-1;flex:0 0 100%;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;padding-bottom:.15rem}.pmdc-pips::-webkit-scrollbar{display:none}.pmdc-pip{flex:none;min-height:44px}}\n@media (prefers-reduced-motion:reduce){.pmdc-card{animation:none}.pmdc-vid{transition:none}}\nh1,h2,h3{text-wrap:balance}\n@keyframes pmdSheenSweep{0%{background-position:200% 0}62%,100%{background-position:-200% 0}}\n.pmd-sheen-w,.pmd-sheen-b{-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;background-size:220% 100%;animation:pmdSheenSweep 6s ease-in-out infinite}\n.pmd-sheen-w{background-image:linear-gradient(100deg,#fff 0%,#fff 42%,#eaf2ff 50%,#fff 58%,#fff 100%)}\n.pmd-sheen-b{background-image:linear-gradient(100deg,#3b82f6 0%,#3b82f6 42%,#bfdbfe 50%,#60a5fa 58%,#3b82f6 100%)}\n@media (prefers-reduced-motion:reduce){.pmd-sheen-w,.pmd-sheen-b{animation:none}}\n@keyframes pmdRise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}\n.pmd-rise{animation:pmdRise .7s cubic-bezier(.22,1,.36,1) both}\n@media (prefers-reduced-motion:reduce){.pmd-rise{animation:none}}"
  ],
  "root": true,
  "wrapper": null,
  "header": "page",
  "footer": "big",
  "footerProps": {
    "kicker": "Get Started",
    "line1": "Book Your Detail.",
    "line2": "We Come to You.",
    "sub": "Mobile ceramic coating and detailing across Officer and South-East Melbourne. Straight quotes, no drop-off.",
    "primary": {
      "text": "Start Your Quote",
      "href": "/booking"
    },
    "secondary": {
      "text": "Call 0411 566 186",
      "href": "tel:0411566186"
    },
    "blurb": "Premium mobile car detailing, ceramic coating and paint protection serving Officer, South-East Melbourne and Victoria-wide for larger jobs. We bring the shine to your door."
  },
  "map": false
};
---
<Base {...page}>
  <Fragment set:html={html} />
</Base>
