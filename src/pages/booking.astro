---
import Base from '../layouts/Base.astro';
import html from '../content-html/booking.html?raw';
const page = {
  "title": "Book Now | Premier Mobile Detailing",
  "description": "Book your mobile detailing, ceramic coating, paint correction or full detail with Premier Mobile Detailing. Serving Officer & South-East Melbourne — we come to you.",
  "canonical": "https://premiermobiledetailing.com.au/booking",
  "robots": null,
  "og": {},
  "twitter": {},
  "jsonld": [],
  "preloads": [],
  "styles": [
    "    body{background:#080B16;margin:0;color:#fff}\n    /* hero tagline: NLP metal on white + blue accent */\n    .pmd-book-metal{background-image:linear-gradient(90deg,#bfc2c7 0%,#fff 5%,#fafbfc 15%,#cfd2d6 30%,#fff 65%,#bfc2c7 80%,#f8f9fa 90%,#fff 95%,#bfc2c7 100%) !important;background-repeat:repeat !important;\n      background-size:200% 100% !important;-webkit-background-clip:text !important;background-clip:text !important;\n      -webkit-text-fill-color:transparent !important;color:transparent !important;animation:pmdShineSweep 6s ease-in-out infinite !important}\n    .pmd-book-blue{background:linear-gradient(102deg,#6aa0ff,#2f6bff,#1a52e6) !important;-webkit-background-clip:text !important;background-clip:text !important;\n      -webkit-text-fill-color:transparent !important;color:transparent !important}\n    @keyframes pmdShineSweep{0%{background-position:200% 0}100%{background-position:-200% 0}}\n    .enq-label{display:block;font-size:13px;font-weight:600;color:#cbd2dd;margin:0 0 6px}\n    .enq-field{width:100%;box-sizing:border-box;background:rgba(9,13,24,.55);border:1px solid rgba(255,255,255,.16);border-radius:10px;\n      padding:12px 14px;color:#fff;font-size:15px;font-family:inherit;transition:border-color .2s, box-shadow .2s;outline:none}\n    .enq-field::placeholder{color:#8b93a3}\n    .enq-field:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.25)}\n    textarea.enq-field{resize:vertical;min-height:110px}\n    .enq-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n    @media (max-width:640px){.enq-row{grid-template-columns:1fr}}\n\n    /* ---- stepped booking card (glassmorphism) ---- */\n    .pmd-book-wrap{max-width:720px;margin:0 auto;padding:0 20px}\n    .pmd-book-card{background:linear-gradient(160deg, rgba(255,255,255,.13), rgba(255,255,255,.05));\n      -webkit-backdrop-filter:blur(26px) saturate(150%);backdrop-filter:blur(26px) saturate(150%);\n      border:1px solid rgba(255,255,255,.22);border-radius:22px;padding:26px 30px 34px;\n      box-shadow:0 40px 90px -30px rgba(0,0,0,.85), inset 0 1px 0 rgba(255,255,255,.28)}\n    @media (max-width:640px){.pmd-book-card{padding:20px 16px 26px;border-radius:18px}}\n\n    /* step indicator (4 circles like Glossed Out) */\n    .pmd-steps{display:flex;align-items:flex-start;justify-content:space-between;position:relative;margin:2px 0 24px;padding:0 8px}\n    .pmd-steps::before{content:'';position:absolute;top:16px;left:26px;right:26px;height:2px;background:rgba(255,255,255,.18);z-index:0}\n    .pmd-stp{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:8px;flex:1}\n    .pmd-stp-dot{width:34px;height:34px;border-radius:9999px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;\n      background:rgba(9,13,24,.6);border:2px solid rgba(255,255,255,.28);color:#cfd6e2;transition:background .3s, border-color .3s, color .3s, box-shadow .3s}\n    .pmd-stp-lbl{font-size:11.5px;color:#c3cad7;font-weight:600;text-align:center;letter-spacing:.02em;transition:color .3s}\n    .pmd-stp.done .pmd-stp-dot{background:#2f6bff;border-color:#2f6bff;color:#fff}\n    .pmd-stp.active .pmd-stp-dot{background:#2f6bff;border-color:#2f6bff;color:#fff;box-shadow:0 0 0 4px rgba(47,107,255,.30)}\n    .pmd-stp.active .pmd-stp-lbl{color:#fff}\n    .pmd-stp:not(.done):not(.active) .pmd-stp-lbl{color:#8b93a3}\n\n    .pmd-h{font-size:25px;font-weight:800;letter-spacing:-.01em;margin:0 0 4px;color:#fff}\n    .pmd-sub{color:#c3cad7;font-size:14px;margin:0 0 22px}\n    @keyframes pmdStepIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}\n    .pmd-step{animation:pmdStepIn .34s ease both}\n    .pmd-step[hidden]{display:none}\n\n    /* selectable cards (packages + location) */\n    .pmd-grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n    @media (max-width:560px){.pmd-grid2{grid-template-columns:1fr}}\n    .pmd-card{position:relative;text-align:left;background:rgba(9,13,24,.5);border:1.5px solid rgba(255,255,255,.16);border-radius:14px;\n      padding:15px 16px;cursor:pointer;color:#fff;font-family:inherit;transition:transform .15s, border-color .2s, background .2s, box-shadow .3s}\n    .pmd-card:hover{transform:translateY(-3px);border-color:rgba(47,107,255,.6);box-shadow:0 16px 34px -18px rgba(47,107,255,.7)}\n    .pmd-card.sel{border-color:#2f6bff;background:rgba(16,27,51,.85);box-shadow:0 0 0 3px rgba(47,107,255,.3)}\n    .pmd-card-t{display:block;font-weight:700;font-size:15px;margin-bottom:3px}\n    .pmd-card-d{display:block;font-size:12.5px;color:#aab4c5;line-height:1.35}\n    .pmd-card-ic{display:block;font-size:24px;margin-bottom:8px}\n    .pmd-card-tick{position:absolute;top:12px;right:12px;width:20px;height:20px;border-radius:9999px;background:#2f6bff;color:#fff;\n      display:none;align-items:center;justify-content:center;font-size:12px}\n    .pmd-card.sel .pmd-card-tick{display:flex}\n    .pmd-loc-hint{font-size:12.5px;color:#aab4c5;margin:8px 0 0}\n    .pmd-inline-err{color:#fecaca;font-size:13px;margin-top:14px}\n\n    .pmd-nav{display:flex;gap:12px;margin-top:22px}\n    .enq-btn{flex:1;background:#2563eb;color:#fff;border:0;border-radius:10px;padding:15px;font-size:16px;font-weight:700;cursor:pointer;\n      transition:transform .15s, box-shadow .3s, background .2s}\n    .enq-btn:hover{background:#1d4ed8;transform:translateY(-2px);box-shadow:0 14px 34px -12px rgba(37,99,235,.7)}\n    .enq-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}\n    .enq-btn.ghost{background:rgba(255,255,255,.06);border:1.5px solid rgba(255,255,255,.22);color:#e6ebf5;flex:0 0 auto;padding-left:26px;padding-right:26px}\n    .enq-btn.ghost:hover{background:rgba(255,255,255,.12);box-shadow:none}\n    .enq-note{display:none;border-radius:10px;padding:14px 16px;margin-top:16px;font-size:14px}\n    .enq-ok{display:block;background:rgba(34,197,94,.14);border:1px solid rgba(34,197,94,.45);color:#bbf7d0}\n    .enq-err{display:block;background:rgba(239,68,68,.14);border:1px solid rgba(239,68,68,.45);color:#fecaca}\n\n    /* contact info cards (Glossed Out style) */\n    .pmd-contact{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px}\n    @media (max-width:560px){.pmd-contact{grid-template-columns:1fr}}\n    .pmd-cc{display:block;text-align:left;background:linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.04));\n      -webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);\n      border:1px solid rgba(255,255,255,.16);border-radius:14px;padding:14px 16px;color:#fff;text-decoration:none;\n      transition:background .2s, border-color .2s, transform .15s}\n    a.pmd-cc:hover{background:linear-gradient(160deg, rgba(255,255,255,.16), rgba(255,255,255,.06));border-color:rgba(47,107,255,.55);transform:translateY(-2px)}\n    .pmd-cc-ic{font-size:18px}\n    .pmd-cc-l{display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:.13em;color:#9aa4b5;margin:7px 0 3px;font-weight:700}\n    .pmd-cc-v{display:block;font-size:14px;font-weight:600;color:#eef2f8;word-break:break-word}\n  "
  ],
  "root": true,
  "wrapper": null,
  "header": "page",
  "footer": "none",
  "footerProps": null,
  "map": false
};
---
<Base {...page}>
  <Fragment set:html={html} />
</Base>
