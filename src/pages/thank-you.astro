---
import Base from '../layouts/Base.astro';
import html from '../content-html/thank-you.html?raw';
const page = {
  "title": "Thank You | Premier Mobile Detailing",
  "description": "Thanks — your booking request has been received. Premier Mobile Detailing will be in touch shortly to confirm your time.",
  "canonical": "https://premiermobiledetailing.com.au/thank-you",
  "robots": "noindex",
  "og": {},
  "twitter": {},
  "jsonld": [],
  "preloads": [],
  "styles": [
    "    body{background:#080B16;margin:0;color:#e6ebf5;font-family:'DM Sans',system-ui,-apple-system,sans-serif;line-height:1.7;min-height:100vh}\n    .ty-wrap{max-width:720px;margin:0 auto;padding:0 22px}\n\n    nav.ty-nav{position:fixed;top:0;left:0;right:0;z-index:50;padding:14px 16px 0}\n    .ty-nav-in{max-width:1120px;margin:0 auto;height:60px;display:flex;align-items:center;justify-content:space-between;padding:0 12px 0 24px;\n      background:rgba(11,16,28,.72);-webkit-backdrop-filter:blur(16px) saturate(150%);backdrop-filter:blur(16px) saturate(150%);\n      border:1px solid rgba(255,255,255,.12);border-radius:9999px;box-shadow:0 12px 34px rgba(0,0,0,.45)}\n    .ty-nav-in img{height:36px;width:auto}\n    .ty-nav-links{display:flex;gap:22px;align-items:center;font-size:14px;font-weight:600}\n    .ty-nav-links a{color:#e6ebf5;text-decoration:none}\n    .ty-nav-links a:hover{color:#6aa0ff}\n    .ty-cta{background:#2563eb;color:#fff !important;padding:9px 20px;border-radius:9999px;font-weight:700}\n    @media (max-width:640px){.ty-nav-links a:not(.ty-cta){display:none}}\n\n    .ty-main{position:relative;overflow:hidden;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:120px 0 70px}\n    .ty-main::before{content:'';position:absolute;inset:0;z-index:-2;background:linear-gradient(rgba(8,11,22,.72), rgba(11,16,32,.82)), url('/assets/images/carbon-bg.jpg');background-size:cover;background-position:center}\n    .ty-main::after{content:'';position:absolute;inset:0;z-index:-1;background:radial-gradient(760px 520px at 50% 34%, rgba(37,99,235,.22), transparent 62%)}\n\n    .ty-card{\n      text-align:center;\n      background:linear-gradient(160deg, rgba(255,255,255,.08), rgba(255,255,255,.028));\n      -webkit-backdrop-filter:blur(22px) saturate(140%);backdrop-filter:blur(22px) saturate(140%);\n      border:1px solid rgba(255,255,255,.14);border-radius:28px;\n      padding:52px 42px 46px;\n      box-shadow:0 60px 120px -50px rgba(0,0,0,.85), inset 0 1px 0 rgba(255,255,255,.16);\n    }\n    .ty-logo{height:44px;width:auto;margin:0 auto 20px;display:block}\n    .ty-check{width:78px;height:78px;margin:0 auto 20px;display:block}\n    .ty-check circle{fill:rgba(47,107,255,.14);stroke:#3f7dff;stroke-width:3}\n    .ty-check path{fill:none;stroke:#6aa0ff;stroke-width:6;stroke-linecap:round;stroke-linejoin:round;\n      stroke-dasharray:48;stroke-dashoffset:48;animation:tyDraw .7s .25s cubic-bezier(.65,0,.35,1) forwards}\n    @keyframes tyDraw{to{stroke-dashoffset:0}}\n    @media (prefers-reduced-motion: reduce){.ty-check path{animation:none;stroke-dashoffset:0}}\n\n    .ty-eyebrow{color:#6aa0ff;font-size:12px;font-weight:800;letter-spacing:.24em;text-transform:uppercase;margin:0 0 14px}\n    .ty-title{font-size:clamp(29px,5vw,44px);font-weight:800;letter-spacing:-.01em;color:#fff;margin:0;line-height:1.08;text-wrap:balance}\n    .ty-title span{background:linear-gradient(102deg,#6aa0ff,#2f6bff,#1a52e6);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}\n    .ty-lead{color:#c3cad7;font-size:17px;margin:16px auto 0;max-width:480px;text-wrap:pretty}\n    .ty-svc{display:inline-block;margin-top:18px;padding:7px 16px;font-size:13px;font-weight:700;letter-spacing:.04em;\n      color:#dfe6f2;background:rgba(47,107,255,.12);border:1px solid rgba(47,107,255,.3);border-radius:9999px}\n\n    .ty-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:34px 0 6px;text-align:left}\n    .ty-step{background:rgba(9,13,24,.5);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:16px 16px 15px}\n    .ty-step b{display:block;color:#6aa0ff;font-family:'Bebas Neue',Impact,sans-serif;font-size:26px;line-height:1;margin-bottom:8px;letter-spacing:.02em}\n    .ty-step p{margin:0;font-size:13.5px;color:#c3cad7;line-height:1.5;text-wrap:pretty}\n    @media (max-width:620px){.ty-steps{grid-template-columns:1fr}.ty-card{padding:44px 24px 38px}}\n\n    .ty-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:32px}\n    .ty-btn{display:inline-flex;align-items:center;gap:9px;height:50px;padding:0 26px;border-radius:9999px;font-weight:700;font-size:15px;text-decoration:none;transition:transform .2s, box-shadow .3s, background .2s}\n    .ty-btn svg{width:17px;height:17px}\n    .ty-btn-primary{background:#2563eb;color:#fff;box-shadow:0 14px 34px -10px rgba(37,99,235,.6)}\n    .ty-btn-primary:hover{transform:translateY(-2px);box-shadow:0 20px 44px -12px rgba(37,99,235,.7)}\n    .ty-btn-ghost{background:rgba(255,255,255,.06);color:#e6ebf5;border:1px solid rgba(255,255,255,.16)}\n    .ty-btn-ghost:hover{transform:translateY(-2px);background:rgba(255,255,255,.1)}\n    .ty-home{display:inline-block;margin-top:24px;color:#8b95a7;font-size:14px;text-decoration:none}\n    .ty-home:hover{color:#c3cad7}\n  "
  ],
  "root": false,
  "wrapper": null,
  "header": "none",
  "footer": "none",
  "footerProps": null,
  "map": false
};
---
<Base {...page}>
  <Fragment set:html={html} />
</Base>
