---
// /mobile-detailing: the service-area hub. Map of all 54 suburb pages, the
// directory grouped by council, how mobile detailing works, CTA. The directory
// and the map data were baked into _hub.html from src/data/suburbs.json.
import Base from '../../layouts/Base.astro';
import html from '../../content-html/mobile-detailing/_hub.html?raw';
import suburbs from '../../data/suburbs.json';

const SITE = 'https://premiermobiledetailing.com.au';
const title = 'Mobile Car Detailing Service Areas | South-East Melbourne | Premier Mobile Detailing';
const description = 'Mobile car detailing, paint correction and ceramic coating across 114 suburbs of South-East Melbourne and West Gippsland. Based in Officer, we come to Berwick, Pakenham, Cranbourne, Dandenong, Frankston, Knox, Monash and more.';
const page = {
  title, description,
  canonical: `${SITE}/mobile-detailing`,
  og: { title, description, type: 'website', image: `${SITE}/assets/images/57982f66-2a3a-44b2-8853-af37ac4c757d.webp`, url: `${SITE}/mobile-detailing` },
  twitter: { card: 'summary_large_image', title, description, image: `${SITE}/assets/images/57982f66-2a3a-44b2-8853-af37ac4c757d.webp` },
  jsonld: [
    {
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Service Areas', item: `${SITE}/mobile-detailing` },
      ],
    },
    {
      '@context': 'https://schema.org', '@type': 'ItemList', name: 'Premier Mobile Detailing service areas',
      numberOfItems: suburbs.length,
      itemListElement: suburbs.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${SITE}/mobile-detailing/${s.slug}` })),
    },
    {
      '@context': 'https://schema.org', '@type': 'LocalBusiness', name: 'Premier Mobile Detailing',
      url: `${SITE}/mobile-detailing`, telephone: '0411566186',
      image: `${SITE}/assets/images/45ead650-192d-44cb-8c3f-0ae51ecbbc4b.webp`,
      address: { '@type': 'PostalAddress', addressLocality: 'Officer', addressRegion: 'VIC', postalCode: '3809', addressCountry: 'AU' },
      areaServed: suburbs.map((s) => ({ '@type': 'City', name: s.name })),
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '55' },
    },
  ],
  preloads: [], styles: [],
  root: true, wrapper: 'min-h-screen bg-background text-foreground selection:bg-primary/30', header: 'page', footer: 'suburb', map: true,
};
---
<Base {...page}>
  <Fragment set:html={html} />
</Base>
