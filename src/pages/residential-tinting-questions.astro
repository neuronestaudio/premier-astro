          "@type": "Question",
          "name": "Does home tint reduce power bills?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "By cutting solar heat gain, it eases the load on your cooling, especially on west- and north-facing glass in summer."
          }
        },
        {
          "@type": "Question",
          "name": "Does it stop furniture fading?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It blocks the majority of UV, dramatically slowing fading of floors, rugs, artwork and furniture."
          }
        },
        {
          "@type": "Question",
          "name": "Can I get privacy without frosting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — daytime one-way privacy films let you see out while limiting the view in, without a frosted look."
          }
        },
        {
          "@type": "Question",
          "name": "Does film help in winter too?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some low-e films help retain heat in winter as well as reject it in summer — we can advise on the right film for your goals."
          }
